################################################################################
#  HFOFO (Helical FOFO snake) muon ionization-cooling channel
#  G4beamline configuration  --  31-period snake + matching + exit solenoid
#
#  This is the canonical HFOFO cooling lattice (tilted solenoids + 325 MHz RF
#  pillbox cavities + LiH wedge absorbers).  Originally Yuri Alexahin's design
#  ("track_v7"); restructured here so that the handful of physics-meaningful
#  knobs the optimizer tunes live in one clearly marked block at the top.
#
#  Run directly:
#      g4bl hfofo.in
#  or through the optimization framework (see ../optimization/README.md), which
#  rewrites the values in the OPTIMIZER PARAMETERS block for each trial.
################################################################################

### ----------------------------------------------------------------------------
### OPTIMIZER PARAMETERS   (the optimizer rewrites these `param NAME=...` lines)
### ----------------------------------------------------------------------------
# BLS    : overall solenoid field strength scale (focusing) -- nominal 21.4
# Grad   : RF gradient in the main snake cavities  (MV/m)    -- nominal 25
# Grad0  : RF gradient in the matching cavities     (MV/m)   -- nominal 20
# delf   : SolPos/SolNeg current asymmetry (dimensionless)   -- nominal 0
# nEvents: number of muons to track                          -- set by runner
# pitchFactor : scale on the periodic-section solenoid tilt   -- nominal 1
# dtRF        : global RF phase offset (ns; T_RF = 3.077 ns)   -- nominal 0
# wedgeScale  : scale on all LiH wedge widths (cooling material)-- nominal 1
# wedgeScaleStart/End : linear taper of wedge width along the channel
#               (period 1 -> 30); both nominal 1 = flat. Multiplies wedgeScale.
# wedgeScaleMidBump : triangular mid-channel bump added to the taper
#               (0 at both ends, full value at mid-channel); 0 = pure linear.
# irisScale   : scale on the small RF irises RFC1(250mm)+RFC2(200mm) -- nominal 1
# rngSeed     : Geant4 random seed (fixed => common random numbers)
param BLS=21.4
param Grad=25
param Grad0=20
param delf=0
param pitchFactor=1.0
param dtRF=0.0
param wedgeScale=1.0
param wedgeScaleStart=1.0
param wedgeScaleEnd=1.0
param wedgeScaleMidBump=0.0
param irisScale=1.0
param rngSeed=1
param nEvents=100
### ----------------------------------------------------------------------------

material GH2 Z=1 A=1.01 density=0.014 # 20% of LH2
param worldMaterial=GH2

param pi=3.1415926

randomseed Set $rngSeed

physics QGSP_BIC

param zshift=60
param period=4200 # HFOFO period

param beamstart=-700 # from the rotator solenoid exit at z=0
#beam ascii file=initial.dat beamZ=$beamstart # user provided file with particle data
beam ascii file=initial_shuffled.dat beamZ=$beamstart nEvents=$nEvents  # representative (momentum-shuffled) sample of initial.dat

param TRF=1/325*10^3
param beamtime=-0.671 # average time of mu+ in initial.dat modulo RF period TRF
# if there is no mu+ take mu- and add TRF/2

param toffs0=$beamtime-$beamstart/275.89-.07+$dtRF # time needed to travel from beamZ to 0

param toffs1=$toffs0-.061-.0026+.0115+.006 # timing on the beam core done iteratively
param toffs2=$toffs1-.064+.149-.0052-.0029
param toffs3=$toffs2
param toffs4=$toffs3
param toffs5=$toffs4-.008
param toffs6=$toffs5

# Additional parameters
trackcuts keep=mu+,mu-,pi+,pi- kineticEnergyCut=50

param maxStep=10.0 steppingVerbose=0 nTrace=0

### detector

include detectors.txt
virtualdetector DetLast file=outlast format=ascii radius=300 color=0,1,0 length=0.001 material=Vacuum

### Mag Field

coil kat0 innerRadius=360 outerRadius=500 length=6000 nSheets=10 maxR=360 maxZ=9000 dR=20 dZ=20 \
tolerance=0.003

solenoid RotSol coilName=kat0 current=11.37 kill=1

coil kat11 innerRadius=420 outerRadius=600 length=300 nSheets=10 maxR=360 maxZ=6000 dR=15 dZ=15 \
tolerance=0.003

param pitch=-0.0025*180/$pi*$pitchFactor
param cur0=4.421*$BLS
param curpl=$cur0*(1+$delf/2) curmn=-$cur0*(1-$delf/2)
param cur1=4.421*10.98 cur2=-4.421*17.89 cur3=4.421*19.64 cur4=-4.421*21.12 # entrance
param cur5=4.421*10.06 cur6=-4.421*16.03 cur7=4.421*17.81 cur8=-4.421*19.17 cur9=4.421*19.20 # exit

include solangles1.dat
include solangles2.dat

solenoid SolPos coilName=kat11 current=$curpl kill=1 color=invisible # color=1,0,1
solenoid SolNeg coilName=kat11 current=$curmn kill=1 color=invisible # color=0,0,1

### collimators

tubs abtube length=160 innerRadius=500 outerRadius=550 material=Vacuum kill=1 color=invisible
tubs terminus length=1 innerRadius=0 outerRadius=360 material=Vacuum kill=1 color=invisible

### pressure wall

tubs presswall length=4 outerRadius=360 material=Stainless316 color=invisible

# LiH wedge absorber

trap wedge0 height=350 length=700 upperWidth=0.005 lowerWidth=59.5 material=LITHIUM_HYDRIDE color=0,0,1

### define the pillbox RF cavity

pillbox RFC0 innerLength=249 frequency=0.325 maxGradient=$Grad0 \
win1Thick=0 win1OuterRadius=0 collarThick=0 collarRadialThick=0\
winMat=Be irisRadius=300 win2Thick=0.12 wallThick=0.4 pipeThick=0.4

pillbox RFC innerLength=249 frequency=0.325 maxGradient=$Grad \
win1Thick=0 win1OuterRadius=0 collarThick=0 collarRadialThick=0\
winMat=Be irisRadius=300 win2Thick=0.12 wallThick=0.4 pipeThick=0.4 cavityMaterial=GH2 kill=1

pillbox RFC1 innerLength=249 frequency=0.325 maxGradient=$Grad \
win1Thick=0 win1OuterRadius=0 collarThick=0 collarRadialThick=0\
winMat=Be irisRadius=250*$irisScale win2Thick=0.1 wallThick=0.4 pipeThick=0.4 cavityMaterial=GH2 kill=1

pillbox RFC2 innerLength=249 frequency=0.325 maxGradient=$Grad \
win1Thick=0 win1OuterRadius=0 collarThick=0 collarRadialThick=0\
winMat=Be irisRadius=200*$irisScale win2Thick=0.07 wallThick=0.4 pipeThick=0.4 cavityMaterial=GH2 kill=1

param np=31 # number of snake periods
param zlastRF=$np*$period+1450

# per-period wedge taper factors (linear wedgeScaleStart -> wedgeScaleEnd)
param ws1=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.000000+$wedgeScaleMidBump*0.000000
param ws2=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.034483+$wedgeScaleMidBump*0.068966
param ws3=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.068966+$wedgeScaleMidBump*0.137932
param ws4=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.103448+$wedgeScaleMidBump*0.206896
param ws5=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.137931+$wedgeScaleMidBump*0.275862
param ws6=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.172414+$wedgeScaleMidBump*0.344828
param ws7=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.206897+$wedgeScaleMidBump*0.413794
param ws8=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.241379+$wedgeScaleMidBump*0.482758
param ws9=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.275862+$wedgeScaleMidBump*0.551724
param ws10=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.310345+$wedgeScaleMidBump*0.620690
param ws11=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.344828+$wedgeScaleMidBump*0.689656
param ws12=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.379310+$wedgeScaleMidBump*0.758620
param ws13=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.413793+$wedgeScaleMidBump*0.827586
param ws14=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.448276+$wedgeScaleMidBump*0.896552
param ws15=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.482759+$wedgeScaleMidBump*0.965518
param ws16=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.517241+$wedgeScaleMidBump*0.965518
param ws17=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.551724+$wedgeScaleMidBump*0.896552
param ws18=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.586207+$wedgeScaleMidBump*0.827586
param ws19=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.620690+$wedgeScaleMidBump*0.758620
param ws20=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.655172+$wedgeScaleMidBump*0.689656
param ws21=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.689655+$wedgeScaleMidBump*0.620690
param ws22=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.724138+$wedgeScaleMidBump*0.551724
param ws23=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.758621+$wedgeScaleMidBump*0.482758
param ws24=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.793103+$wedgeScaleMidBump*0.413794
param ws25=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.827586+$wedgeScaleMidBump*0.344828
param ws26=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.862069+$wedgeScaleMidBump*0.275862
param ws27=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.896552+$wedgeScaleMidBump*0.206896
param ws28=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.931034+$wedgeScaleMidBump*0.137932
param ws29=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*0.965517+$wedgeScaleMidBump*0.068966
param ws30=$wedgeScaleStart+($wedgeScaleEnd-$wedgeScaleStart)*1.000000+$wedgeScaleMidBump*0.000000

include abs_place.txt
include RFplace.txt
include sol_place.txt

place DetLast z=$zlastRF+100
place terminus z=-1000 # to stop reflected particles
place terminus z=$zlastRF+102

### Data read-out

zntuple zloop=-700:125985:700 format=ascii file=mu_plus_beam
